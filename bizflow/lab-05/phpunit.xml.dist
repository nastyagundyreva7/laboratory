<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php" colors="true">
  <php><ini name="error_reporting" value="-1"/><server name="APP_ENV" value="test"/><server name="KERNEL_CLASS" value="App\Kernel"/></php>
  <testsuites><testsuite name="BizFlow"><directory>tests</directory></testsuite></testsuites>
</phpunit>
