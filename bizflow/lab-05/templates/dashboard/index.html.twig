{% extends 'base.html.twig' %}{% block title %}RUD COIN — панель программы{% endblock %}{% block body %}<p class="eyebrow">УПРАВЛЕНИЕ ПРОГРАММОЙ ЛОЯЛЬНОСТИ</p><h1>Панель RUD COIN</h1><p class="muted">Сводные показатели рассчитываются из базы данных через Doctrine ORM.</p><section class="stats"><div class="stat"><span class="muted">Студенты</span><strong>{{ students }}</strong></div><div class="stat"><span class="muted">Кошельки</span><strong>{{ wallets }}</strong></div><div class="stat"><span class="muted">Баланс всех кошельков</span><strong>{{ coins }} RDC</strong></div></section><section class="panel"><h2>Последние операции</h2>{% if transactions is empty %}<p class="muted">Операций пока нет. Добавьте демонстрационные данные через fixtures.</p>{% else %}<table><tr><th>Студент</th><th>Тип</th><th>Сумма</th><th>Описание</th><th>Дата</th></tr>{% for tx in transactions %}<tr><td>{{ tx.wallet.student.name }}</td><td>{{ tx.type == 'earn' ? 'Начисление' : 'Списание' }}</td><td>{{ tx.type == 'earn' ? '+' : '−' }}{{ tx.amount }} RDC</td><td>{{ tx.description }}</td><td>{{ tx.createdAt|date('d.m.Y H:i') }}</td></tr>{% endfor %}</table>{% endif %}</section><section class="grid"><article class="tile"><h3>События</h3>{% for event in events %}<p><strong>{{ event.title }}</strong><br>{{ event.startsAt|date('d.m.Y H:i') }} · {{ event.rewardCoins }} RDC</p>{% else %}<p>События не добавлены.</p>{% endfor %}</article><article class="tile"><h3>Привилегии</h3>{% for privilege in privileges %}<p><strong>{{ privilege.title }}</strong><br>{{ privilege.costCoins }} RDC · {{ privilege.description }}</p>{% else %}<p>Привилегии не добавлены.</p>{% endfor %}</article><article class="tile"><h3>Модель данных</h3><p>Student → Wallet → CoinTransaction; UniversityEvent и Privilege хранят справочные данные программы.</p></article></section>{% endblock %}
