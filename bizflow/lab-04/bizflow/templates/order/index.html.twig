{% extends 'base.html.twig' %}{% block title %}Заказы — BizFlow{% endblock %}{% block body %}<section class="card"><h1>Заказы</h1><div class="table-scroll"><table><thead><tr><th>Номер</th><th>Клиент</th><th>Статус</th><th>Сумма</th></tr></thead><tbody>{% for order in orders %}<tr><td><a href="{{ path('order_show',{id:order.id}) }}">{{ order.id }}</a></td><td>{{ order.customer }}</td><td>{{ order.status }}</td><td>{{ order.total }}</td></tr>{% endfor %}</tbody></table></div></section>{% endblock %}
