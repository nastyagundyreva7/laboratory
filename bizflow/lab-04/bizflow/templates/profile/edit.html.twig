{% extends 'base.html.twig' %}{% block title %}Профиль — RUD COIN{% endblock %}{% block body %}<section class="form-card"><p class="eyebrow">ЛИЧНЫЙ КАБИНЕТ</p><h1>Профиль студента</h1><p class="muted">Заполни данные участника программы RUD COIN.</p>{{ form_start(form) }}{{ form_row(form.name) }}{{ form_row(form.email) }}{{ form_row(form.faculty) }}{{ form_row(form.program) }}{{ form_row(form.about) }}{{ form_row(form.save,{'attr':{'class':'btn'}}) }}{{ form_end(form) }}{% if profile.name is defined %}<hr><h2>Сохранённые данные</h2><p><strong>{{ profile.name }}</strong> · {{ profile.email }}</p><p>{{ profile.faculty }} · {{ profile.program }}</p>{% endif %}<p class="muted">Для лабораторной №4 данные сохраняются в сессии, без подключения базы данных.</p></section>{% endblock %}
