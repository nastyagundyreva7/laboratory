{% extends 'base.html.twig' %}{% block title %}{{ customer.name|e }} — BizFlow{% endblock %}{% block body %}<section class="card"><h1>{{ customer.name|title }}</h1><dl><dt>Email</dt><dd>{{ customer.email|lower }}</dd><dt>Телефон</dt><dd>{{ customer.phone|default('Не указан') }}</dd><dt>Компания</dt><dd>{{ customer.company|default('Не указана') }}</dd><dt>Комментарий</dt><dd>{{ customer.comment|default('Нет комментария')|e|nl2br }}</dd></dl><div class="actions"><a class="button-link" href="{{ path('customer_edit',{id:customer.id}) }}">Редактировать</a><a href="{{ path('customer_index') }}">К списку</a></div></section>{% endblock %}
