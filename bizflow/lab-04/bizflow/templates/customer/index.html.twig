{% extends 'base.html.twig' %}{% block title %}Клиенты — BizFlow{% endblock %}{% block body %}<section class="card"><div class="actions"><h1>Клиенты</h1><a class="button-link" href="{{ path('customer_new') }}">Добавить клиента</a></div><form method="get" action="{{ path('customer_index') }}" class="form-grid"><div class="field"><label for="search">Поиск</label><input id="search" name="search" value="{{ search }}" placeholder="Имя, email или компания"></div><div class="field"><label for="sort">Сортировать</label><select id="sort" name="sort"><option value="name" {{ sort == 'name' ? 'selected' }}>По имени</option><option value="email" {{ sort == 'email' ? 'selected' }}>По email</option></select></div><div class="actions"><button type="submit">Применить</button></div></form><div class="table-scroll"><table><thead><tr><th>ID</th><th>Имя</th><th>Email</th><th>Компания</th><th>Действия</th></tr></thead><tbody>{% for customer in customers %}<tr><td>{{ customer.id }}</td><td>{{ customer.name|e }}</td><td>{{ customer.email|lower }}</td><td>{{ customer.company|default('—') }}</td><td><a href="{{ path('customer_show',{id:customer.id}) }}">Открыть</a></td></tr>{% else %}<tr><td colspan="5">Клиенты не найдены.</td></tr>{% endfor %}</tbody></table></div><p>Найдено записей: {{ customers|length }}</p></section>{% endblock %}
