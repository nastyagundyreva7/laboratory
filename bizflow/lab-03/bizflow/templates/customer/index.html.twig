{% extends 'base.html.twig' %}{% block title %}Клиенты{% endblock %}{% block body %}<section class="card"><h1>Клиенты</h1><table><thead><tr><th>ID</th><th>Имя</th><th>Email</th><th>Компания</th></tr></thead><tbody>{% for customer in customers %}<tr><td>{{ customer.id }}</td><td><a href="{{ path('customer_show', {id: customer.id}) }}">{{ customer.name }}</a></td><td>{{ customer.email }}</td><td>{{ customer.company }}</td></tr>{% else %}<tr><td colspan="4">Клиентов пока нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
