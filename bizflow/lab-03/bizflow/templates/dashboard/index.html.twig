{% extends 'base.html.twig' %}{% block title %}Кошелёк — RUD COIN{% endblock %}{% block body %}<p class="eyebrow">ЛИЧНЫЙ КАБИНЕТ · ДЕМО-ДАННЫЕ</p><h1>Кошелёк RUD COIN</h1><section class="stats"><div class="stat"><span class="muted">Доступный баланс</span><strong>{{ wallet.balance }} RDC</strong></div><div class="stat"><span class="muted">Начислено</span><strong>{{ wallet.earned }} RDC</strong></div><div class="stat"><span class="muted">Использовано</span><strong>{{ wallet.spent }} RDC</strong></div></section><section class="panel"><h2>История операций</h2><table><thead><tr><th>Дата</th><th>Операция</th><th>Сумма</th></tr></thead><tbody>{% for item in transactions %}<tr><td>{{ item.date }}</td><td>{{ item.title }}</td><td><strong>{{ item.amount }}</strong></td></tr>{% endfor %}</tbody></table><p class="muted">Это демонстрационные записи интерфейса, не реальные операции.</p></section>{% endblock %}
