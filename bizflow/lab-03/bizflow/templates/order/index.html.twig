{% extends 'base.html.twig' %}{% block title %}Заказы{% endblock %}{% block body %}<section class="card"><h1>Заказы</h1><table><thead><tr><th>ID</th><th>Клиент</th><th>Сумма</th><th>Статус</th></tr></thead><tbody>{% for order in orders %}<tr><td><a href="{{ path('order_show', {id: order.id}) }}">{{ order.id }}</a></td><td>{{ order.customer }}</td><td>{{ order.total }}</td><td>{{ order.status }}</td></tr>{% else %}<tr><td colspan="4">Заказов пока нет.</td></tr>{% endfor %}</tbody></table></section>{% endblock %}
