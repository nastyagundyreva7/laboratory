<!doctype html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}BizFlow{% endblock %}</title>
    <style>
        body{font-family:system-ui,sans-serif;margin:0;background:#f4f6fa;color:#202938}header{background:#18243a;color:white;padding:1rem 5vw}nav{display:flex;gap:1rem;flex-wrap:wrap}nav a{color:white;text-decoration:none}main{max-width:1050px;margin:2rem auto;padding:0 1rem}.card{background:white;border:1px solid #e1e6ef;border-radius:14px;padding:1.25rem;margin:1rem 0}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:.75rem;border-bottom:1px solid #e5e9f0}a{color:#2456a6}.muted{color:#657187}
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<header><strong>BizFlow</strong><nav aria-label="Главная навигация"><a href="{{ path('home') }}">Главная</a><a href="{{ path('customer_index') }}">Клиенты</a><a href="{{ path('order_index') }}">Заказы</a><a href="{{ path('dashboard') }}">Панель управления</a></nav></header>
<main>{% block body %}{% endblock %}</main>
{% block javascripts %}{% endblock %}
</body>
</html>
